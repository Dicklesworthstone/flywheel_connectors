{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/supply-chain-attestation/v1",
  "title": "FCP SupplyChainAttestation v1",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "subject_digest",
    "predicate_type",
    "builder_id",
    "build_type",
    "materials",
    "metadata",
    "slsa_level",
    "provenance_hash",
    "trust_root",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "fcp-supply-chain-attestation" },
    "schema_version": { "const": "1.0" },
    "subject_digest": { "$ref": "#/definitions/blake3Digest" },
    "predicate_type": {
      "type": "string",
      "enum": ["https://slsa.dev/provenance/v1", "https://in-toto.io/Statement/v1"]
    },
    "builder_id": {
      "type": "string",
      "minLength": 1
    },
    "build_type": {
      "type": "string",
      "minLength": 1
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uri", "digest"],
        "additionalProperties": false,
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/definitions/blake3Digest" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["build_started_at", "build_finished_at"],
      "additionalProperties": false,
      "properties": {
        "build_started_at": { "type": "string", "format": "date-time" },
        "build_finished_at": { "type": "string", "format": "date-time" },
        "invocation_id": { "type": "string", "minLength": 1 }
      }
    },
    "slsa_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "provenance_hash": { "$ref": "#/definitions/blake3Digest" },
    "trust_root": {
      "type": "object",
      "required": ["root_type", "root_id"],
      "additionalProperties": false,
      "properties": {
        "root_type": {
          "type": "string",
          "enum": ["sigstore", "tuf", "manual"]
        },
        "root_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "builder_allowlist": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "signature", "signed_fields"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "signed_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "blake3Digest": {
      "type": "string",
      "pattern": "^blake3-256:[a-f0-9]{64}$"
    }
  }
}
