;; Real FCP component fixture. The host tests fill canonical CBOR response
;; fragments; guest code reads request fields, retains authority and increments
;; its own invocation counter. No host callbacks implement its business logic.
(component
  (core module $guest
    (memory (export "memory") 8 8)
    (global $heap (mut i32) (i32.const 65536))
    (global $out (mut i32) (i32.const 16384))
    (global $configured (mut i32) (i32.const 0))
    (global $handshaken (mut i32) (i32.const 0))
    (global $calls (mut i32) (i32.const 0))
    (data (i32.const 64) "id")
    (data (i32.const 80) "input")
    (data (i32.const 96) "nonce")
    (data (i32.const 112) "mode")
    (data (i32.const 128) "configure")
    (data (i32.const 144) "handshake")
    (data (i32.const 160) "health")
    (data (i32.const 176) "invoke")
    (data (i32.const 192) "trap")
    (data (i32.const 208) "malformed")
    (data (i32.const 224) "wrong_id")
    (data (i32.const 240) "error")
    (data (i32.const 256) "spin")
    (data (i32.const 272) "0123456789abcdef")
    (data (i32.const 288) "\a2\64echo")
    (data (i32.const 304) "\65calls")
    (data (i32.const 320) "\65wrong")
    (data (i32.const 336) "yield")
    (data (i32.const 510) "\78\25inst_")
    (data (i32.const 1024) "{{CONFIG}}")
    (data (i32.const 2048) "{{HANDSHAKE_PREFIX}}")
    (data (i32.const 4096) "{{HANDSHAKE_SUFFIX}}")
    (data (i32.const 5120) "{{HEALTH_PREFIX}}")
    (data (i32.const 6144) "{{HEALTH_SUFFIX}}")
    (data (i32.const 7168) "{{INVOKE_PREFIX}}")
    (data (i32.const 8192) "{{INVOKE_MIDDLE}}")
    (data (i32.const 9216) "{{INVOKE_SUFFIX}}")
    (data (i32.const 10240) "{{ERROR_PREFIX}}")
    (data (i32.const 11264) "{{ERROR_SUFFIX}}")

    (func $realloc (export "realloc")
      (param $old i32) (param $old_len i32) (param $align i32) (param $len i32) (result i32)
      (local $ptr i32) (local $end i32)
      (if (i32.eqz (local.get $len)) (then (return (i32.const 0))))
      (local.set $ptr (i32.and (i32.add (global.get $heap) (i32.sub (local.get $align) (i32.const 1)))
        (i32.sub (i32.const 0) (local.get $align))))
      (local.set $end (i32.add (local.get $ptr) (local.get $len)))
      (if (i32.or (i32.lt_u (local.get $end) (local.get $ptr)) (i32.gt_u (local.get $end) (i32.const 524288)))
        (then unreachable))
      (global.set $heap (local.get $end))
      (if (local.get $old_len) (then
        (memory.copy (local.get $ptr) (local.get $old)
          (select (local.get $old_len) (local.get $len) (i32.lt_u (local.get $old_len) (local.get $len))))))
      (local.get $ptr))

    (func $equals (param $a i32) (param $len i32) (param $b i32) (param $blen i32) (result i32)
      (local $i i32)
      (if (i32.ne (local.get $len) (local.get $blen)) (then (return (i32.const 0))))
      (block $done (loop $next
        (br_if $done (i32.eq (local.get $i) (local.get $len)))
        (if (i32.ne (i32.load8_u (i32.add (local.get $a) (local.get $i)))
          (i32.load8_u (i32.add (local.get $b) (local.get $i)))) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
      (i32.const 1))

    ;; Definite-length CBOR helpers for the fixture's existing FCP data types.
    (func $head (param $p i32) (result i32) (local $a i32)
      (local.set $a (i32.and (i32.load8_u (local.get $p)) (i32.const 31)))
      (if (i32.lt_u (local.get $a) (i32.const 24)) (then (return (i32.const 1))))
      (if (i32.gt_u (local.get $a) (i32.const 27)) (then unreachable))
      (i32.add (i32.const 1) (i32.shl (i32.const 1) (i32.sub (local.get $a) (i32.const 24)))))
    (func $count (param $p i32) (result i32) (local $a i32) (local $n i32) (local $i i32) (local $v i32)
      (local.set $a (i32.and (i32.load8_u (local.get $p)) (i32.const 31)))
      (if (i32.lt_u (local.get $a) (i32.const 24)) (then (return (local.get $a))))
      (local.set $n (i32.sub (call $head (local.get $p)) (i32.const 1)))
      (if (i32.gt_u (local.get $n) (i32.const 4)) (then unreachable))
      (loop $next
        (local.set $v (i32.or (i32.shl (local.get $v) (i32.const 8))
          (i32.load8_u (i32.add (local.get $p) (i32.add (local.get $i) (i32.const 1))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $next (i32.lt_u (local.get $i) (local.get $n))))
      (local.get $v))
    (func $skip (param $p i32) (param $depth i32) (result i32)
      (local $major i32) (local $end i32) (local $n i32) (local $i i32)
      (if (i32.gt_u (local.get $depth) (i32.const 64)) (then unreachable))
      (local.set $major (i32.shr_u (i32.load8_u (local.get $p)) (i32.const 5)))
      (local.set $end (i32.add (local.get $p) (call $head (local.get $p))))
      (if (i32.or (i32.eq (local.get $major) (i32.const 2)) (i32.eq (local.get $major) (i32.const 3)))
        (then (return (i32.add (local.get $end) (call $count (local.get $p))))))
      (if (i32.eq (local.get $major) (i32.const 6))
        (then (return (call $skip (local.get $end) (i32.add (local.get $depth) (i32.const 1))))))
      (if (i32.or (i32.eq (local.get $major) (i32.const 4)) (i32.eq (local.get $major) (i32.const 5)))
        (then
          (local.set $n (call $count (local.get $p)))
          (if (i32.eq (local.get $major) (i32.const 5)) (then (local.set $n (i32.mul (local.get $n) (i32.const 2)))))
          (block $done (loop $next
            (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
            (local.set $end (call $skip (local.get $end) (i32.add (local.get $depth) (i32.const 1))))
            (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))))
      (local.get $end))
    (func $field (param $p i32) (param $key i32) (param $key_len i32) (result i32)
      (local $n i32) (local $i i32) (local $value i32)
      (if (i32.ne (i32.shr_u (i32.load8_u (local.get $p)) (i32.const 5)) (i32.const 5))
        (then (return (i32.const 0))))
      (local.set $n (call $count (local.get $p)))
      (local.set $p (i32.add (local.get $p) (call $head (local.get $p))))
      (block $done (loop $next
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $value (call $skip (local.get $p) (i32.const 0)))
        (if (call $equals (i32.add (local.get $p) (call $head (local.get $p)))
          (call $count (local.get $p)) (local.get $key) (local.get $key_len))
          (then (return (local.get $value))))
        (local.set $p (call $skip (local.get $value) (i32.const 0)))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
      (i32.const 0))
    (func $text_eq (param $p i32) (param $text i32) (param $len i32) (result i32)
      (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))
      (call $equals (i32.add (local.get $p) (call $head (local.get $p)))
        (call $count (local.get $p)) (local.get $text) (local.get $len)))
    (func $copy (param $p i32) (param $len i32)
      (memory.copy (global.get $out) (local.get $p) (local.get $len))
      (global.set $out (i32.add (global.get $out) (local.get $len))))
    (func $value (param $p i32)
      (if (i32.eqz (local.get $p)) (then unreachable))
      (call $copy (local.get $p) (i32.sub (call $skip (local.get $p) (i32.const 0)) (local.get $p))))

    (func $dispatch (export "dispatch")
      (param $method i32) (param $method_len i32) (param $request i32) (param $request_len i32) (result i32)
      (local $nonce i32) (local $i i32) (local $v i32) (local $input i32) (local $mode i32) (local $id i32)
      (global.set $out (i32.const 16384))
      (block $done
        (if (call $equals (local.get $method) (local.get $method_len) (i32.const 128) (i32.const 9))
          (then
            (global.set $configured (i32.const 1))
            (call $copy (i32.const 1024) (i32.const {{CONFIG_LEN}})) (br $done)))
        (if (i32.eqz (global.get $configured)) (then unreachable))
        (if (call $equals (local.get $method) (local.get $method_len) (i32.const 144) (i32.const 9))
          (then
            (local.set $nonce (call $field (local.get $request) (i32.const 96) (i32.const 5)))
            (call $copy (i32.const 2048) (i32.const {{HANDSHAKE_PREFIX_LEN}}))
            (call $value (local.get $nonce))
            (call $copy (i32.const 4096) (i32.const {{HANDSHAKE_SUFFIX_LEN}}))
            ;; The guest chooses its actual ID from fresh handshake entropy;
            ;; it never reads a token or requested_instance_id to choose it.
            (local.set $nonce (i32.add (local.get $nonce) (call $head (local.get $nonce))))
            (loop $hex
              (local.set $v (call $count (local.get $nonce)))
              (i32.store8 (i32.add (i32.const 517) (i32.mul (local.get $i) (i32.const 2)))
                (i32.load8_u (i32.add (i32.const 272) (i32.shr_u (local.get $v) (i32.const 4)))))
              (i32.store8 (i32.add (i32.const 518) (i32.mul (local.get $i) (i32.const 2)))
                (i32.load8_u (i32.add (i32.const 272) (i32.and (local.get $v) (i32.const 15)))))
              (local.set $nonce (call $skip (local.get $nonce) (i32.const 0)))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br_if $hex (i32.lt_u (local.get $i) (i32.const 16))))
            (global.set $handshaken (i32.const 1)) (br $done)))
        (if (i32.eqz (global.get $handshaken)) (then unreachable))
        (if (call $equals (local.get $method) (local.get $method_len) (i32.const 160) (i32.const 6))
          (then
            (call $copy (i32.const 5120) (i32.const {{HEALTH_PREFIX_LEN}}))
            (call $copy (i32.const 510) (i32.const 39))
            (call $copy (i32.const 6144) (i32.const {{HEALTH_SUFFIX_LEN}})) (br $done)))
        (if (i32.eqz (call $equals (local.get $method) (local.get $method_len) (i32.const 176) (i32.const 6)))
          (then unreachable))
        (local.set $id (call $field (local.get $request) (i32.const 64) (i32.const 2)))
        (local.set $input (call $field (local.get $request) (i32.const 80) (i32.const 5)))
        (local.set $mode (call $field (local.get $input) (i32.const 112) (i32.const 4)))
        (if (call $text_eq (local.get $mode) (i32.const 192) (i32.const 4)) (then unreachable))
        (if (call $text_eq (local.get $mode) (i32.const 256) (i32.const 4)) (then (loop $spin (br $spin))))
        ;; A finite call crosses the host's 10,000-fuel yield interval, allowing
        ;; retirement tests to seal admission before this invocation completes.
        (if (call $text_eq (local.get $mode) (i32.const 336) (i32.const 5))
          (then
            (loop $yield
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br_if $yield (i32.lt_u (local.get $i) (i32.const 100000))))))
        (if (call $text_eq (local.get $mode) (i32.const 208) (i32.const 9))
          (then
            (i32.store8 (global.get $out) (i32.const 255))
            (global.set $out (i32.add (global.get $out) (i32.const 1))) (br $done)))
        (if (call $text_eq (local.get $mode) (i32.const 240) (i32.const 5))
          (then
            (call $copy (i32.const 10240) (i32.const {{ERROR_PREFIX_LEN}}))
            (call $value (local.get $id))
            (call $copy (i32.const 11264) (i32.const {{ERROR_SUFFIX_LEN}})) (br $done)))
        (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
        (call $copy (i32.const 7168) (i32.const {{INVOKE_PREFIX_LEN}}))
        (if (call $text_eq (local.get $mode) (i32.const 224) (i32.const 8))
          (then (call $copy (i32.const 320) (i32.const 6)))
          (else (call $value (local.get $id))))
        (call $copy (i32.const 8192) (i32.const {{INVOKE_MIDDLE_LEN}}))
        (call $copy (i32.const 288) (i32.const 6))
        (call $value (local.get $input))
        (call $copy (i32.const 304) (i32.const 6))
        (if (i32.ge_u (global.get $calls) (i32.const 24)) (then unreachable))
        (i32.store8 (global.get $out) (global.get $calls))
        (global.set $out (i32.add (global.get $out) (i32.const 1)))
        (call $copy (i32.const 9216) (i32.const {{INVOKE_SUFFIX_LEN}})))
      (i32.store (i32.const 32) (i32.const 16384))
      (i32.store (i32.const 36) (i32.sub (global.get $out) (i32.const 16384)))
      (i32.const 32))
    (func (export "post-return") (param $ptr i32)
      (memory.fill (i32.const 16384) (i32.const 238) (i32.sub (global.get $out) (i32.const 16384)))
      (global.set $heap (i32.const 65536))))
  (core instance $instance (instantiate $guest))
  (func (export "fcp-dispatch")
    (param "method" string) (param "request" (list u8)) (result (list u8))
    (canon lift (core func $instance "dispatch")
      (memory $instance "memory")
      (realloc (func $instance "realloc"))
      (post-return (func $instance "post-return")))))
