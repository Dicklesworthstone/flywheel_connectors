{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/fwc/show/v1",
  "title": "FWC Show v1",
  "description": "Stable JSON output schema for `fwc show --json`, including truth-source metadata.",
  "oneOf": [
    { "$ref": "#/$defs/host_success" },
    { "$ref": "#/$defs/offline_success" },
    { "$ref": "#/$defs/missing_host" },
    { "$ref": "#/$defs/ambiguous_catalog_source" },
    { "$ref": "#/$defs/connector_resolution_error" },
    { "$ref": "#/$defs/truth_source_unavailable" },
    { "$ref": "#/$defs/truth_resolver_internal_error" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_non_empty_string": {
      "anyOf": [
        { "$ref": "#/$defs/non_empty_string" },
        { "type": "null" }
      ]
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "truth_source": {
      "type": "string",
      "enum": ["mesh", "host", "node-local", "offline", "degraded", "fallback-derived", "simulated", "unavailable"]
    },
    "truth_requirement": {
      "type": "string",
      "enum": ["mesh", "mesh-or-host", "any-live"]
    },
    "schema_version": {
      "const": "fcp.fwc.truth-source.v1"
    },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "metadata_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["known", "unknown", "unsupported", "unavailable", "not-applicable"]
        },
        "value": {}
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "command",
        "authoritative",
        "explanation",
        "recoverable",
        "next_actions"
      ],
      "properties": {
        "availability": {
          "type": "string",
          "enum": [
            "live-runtime",
            "offline-artifact",
            "unsupported",
            "planned",
            "unavailable",
            "denied",
            "unknown"
          ]
        },
        "command": { "const": "show" },
        "authoritative": { "type": "boolean" },
        "explanation": { "$ref": "#/$defs/non_empty_string" },
        "recoverable": { "type": "boolean" },
        "next_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "source", "authoritative", "caveat"],
      "properties": {
        "command": { "const": "show" },
        "source": {
          "type": "string",
          "enum": ["live_host_introspection", "workspace_manifest"]
        },
        "authoritative": { "type": "boolean" },
        "caveat": { "$ref": "#/$defs/non_empty_string" },
        "fetched_at": { "$ref": "#/$defs/nullable_non_empty_string" }
      }
    },
    "cache_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hit", "validated", "etag", "age_ms", "source"],
      "properties": {
        "hit": { "type": "boolean" },
        "validated": { "type": "boolean" },
        "etag": {
          "type": "string",
          "pattern": "^blake3-256:"
        },
        "age_ms": { "$ref": "#/$defs/non_negative_integer" },
        "source": { "const": "workspace-manifests" }
      }
    },
    "host_connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "canonical_id",
        "name",
        "version",
        "description",
        "cohort",
        "categories",
        "format",
        "state",
        "enabled",
        "health",
        "last_health_check",
        "archetype",
        "operation_count",
        "max_risk",
        "has_events",
        "manifest_path"
      ],
      "properties": {
        "slug": { "$ref": "#/$defs/non_empty_string" },
        "canonical_id": { "$ref": "#/$defs/non_empty_string" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "version": { "$ref": "#/$defs/non_empty_string" },
        "description": { "type": "string" },
        "cohort": { "type": "null" },
        "categories": { "$ref": "#/$defs/string_array" },
        "format": { "type": "null" },
        "state": { "$ref": "#/$defs/non_empty_string" },
        "enabled": { "type": "boolean" },
        "health": {},
        "last_health_check": {},
        "archetype": { "$ref": "#/$defs/non_empty_string" },
        "operation_count": { "$ref": "#/$defs/non_negative_integer" },
        "max_risk": { "$ref": "#/$defs/non_empty_string" },
        "has_events": { "$ref": "#/$defs/metadata_field" },
        "manifest_path": { "type": "null" }
      }
    },
    "offline_connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "canonical_id",
        "name",
        "version",
        "description",
        "cohort",
        "status",
        "hidden_by_default",
        "non_live_rationale",
        "graduation_guidance",
        "format",
        "state",
        "state_model",
        "archetypes",
        "operation_count",
        "max_risk",
        "has_events",
        "manifest_path"
      ],
      "properties": {
        "slug": { "$ref": "#/$defs/non_empty_string" },
        "canonical_id": { "$ref": "#/$defs/non_empty_string" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "version": { "$ref": "#/$defs/non_empty_string" },
        "description": { "type": "string" },
        "cohort": { "$ref": "#/$defs/nullable_non_empty_string" },
        "status": { "$ref": "#/$defs/nullable_non_empty_string" },
        "hidden_by_default": { "type": "boolean" },
        "non_live_rationale": { "$ref": "#/$defs/nullable_non_empty_string" },
        "graduation_guidance": { "$ref": "#/$defs/nullable_non_empty_string" },
        "format": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/non_empty_string" },
        "state_model": {},
        "archetypes": {
          "anyOf": [
            { "$ref": "#/$defs/string_array" },
            { "type": "null" }
          ]
        },
        "operation_count": { "$ref": "#/$defs/non_negative_integer" },
        "max_risk": { "$ref": "#/$defs/non_empty_string" },
        "has_events": { "$ref": "#/$defs/metadata_field" },
        "manifest_path": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "operation_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "canonical_id",
        "local_id",
        "aliases",
        "summary",
        "capability",
        "risk_level",
        "safety_tier",
        "idempotency",
        "requires_approval",
        "supports_simulate",
        "example_count",
        "rate_limits"
      ],
      "properties": {
        "selector": { "$ref": "#/$defs/non_empty_string" },
        "canonical_id": { "$ref": "#/$defs/non_empty_string" },
        "local_id": { "$ref": "#/$defs/non_empty_string" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "summary": { "type": "string" },
        "capability": { "$ref": "#/$defs/non_empty_string" },
        "risk_level": { "$ref": "#/$defs/non_empty_string" },
        "safety_tier": { "$ref": "#/$defs/non_empty_string" },
        "idempotency": { "$ref": "#/$defs/non_empty_string" },
        "requires_approval": { "type": "boolean" },
        "supports_simulate": {},
        "example_count": { "$ref": "#/$defs/non_negative_integer" },
        "rate_limits": {}
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview", "preview_truncated", "risky_count", "safe_count"],
      "properties": {
        "preview": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation_preview" }
        },
        "preview_truncated": { "type": "boolean" },
        "risky_count": { "$ref": "#/$defs/non_negative_integer" },
        "safe_count": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "host_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "source",
        "mode",
        "message",
        "connector",
        "rate_limits",
        "metadata_gaps",
        "operations",
        "next_actions",
        "provenance",
        "schema_version",
        "_truth_source",
        "availability"
      ],
      "properties": {
        "status": { "const": "ok" },
        "command": { "const": "show" },
        "source": { "const": "host-admin-api" },
        "mode": { "const": "live-introspection" },
        "message": { "$ref": "#/$defs/non_empty_string" },
        "connector": { "$ref": "#/$defs/host_connector" },
        "rate_limits": {},
        "metadata_gaps": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "operations": { "$ref": "#/$defs/operations" },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "offline_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "source",
        "mode",
        "message",
        "connector",
        "zones",
        "capabilities",
        "rate_limits",
        "shared_descriptor",
        "operations",
        "next_actions",
        "provenance",
        "_cache",
        "schema_version",
        "_truth_source",
        "availability"
      ],
      "properties": {
        "status": { "const": "ok" },
        "command": { "const": "show" },
        "source": { "const": "workspace-manifests" },
        "mode": { "const": "offline-artifact" },
        "message": { "$ref": "#/$defs/non_empty_string" },
        "connector": { "$ref": "#/$defs/offline_connector" },
        "zones": { "type": "object", "additionalProperties": true },
        "capabilities": { "type": "object", "additionalProperties": true },
        "rate_limits": {},
        "shared_descriptor": { "type": "object", "additionalProperties": true },
        "operations": { "$ref": "#/$defs/operations" },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "_cache": { "$ref": "#/$defs/cache_evidence" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "missing_host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "schema_version",
        "_truth_source",
        "error",
        "details",
        "next_actions",
        "availability"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "show" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "const": "offline" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message", "recoverable"],
          "properties": {
            "type": { "const": "missing-host-endpoint" },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "type": "boolean" }
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connector", "require_source"],
          "properties": {
            "connector": { "$ref": "#/$defs/non_empty_string" },
            "require_source": {
              "anyOf": [
                { "$ref": "#/$defs/truth_requirement" },
                { "type": "null" }
              ]
            }
          }
        },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "ambiguous_catalog_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "schema_version",
        "_truth_source",
        "error",
        "next_actions",
        "availability"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "show" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "const": "offline" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message", "recoverable"],
          "properties": {
            "type": { "const": "ambiguous-catalog-source" },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "type": "boolean" }
          }
        },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "connector_resolution_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command", "schema_version", "_truth_source", "error"],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "show" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "message",
            "recoverable",
            "selector",
            "did_you_mean",
            "examples",
            "next_actions"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["connector-not-found", "ambiguous-connector"]
            },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "type": "boolean" },
            "selector": { "$ref": "#/$defs/non_empty_string" },
            "did_you_mean": {
              "type": "array",
              "items": { "$ref": "#/$defs/non_empty_string" }
            },
            "examples": { "$ref": "#/$defs/string_array" },
            "next_actions": { "$ref": "#/$defs/next_actions" }
          }
        }
      }
    },
    "truth_source_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "schema_version",
        "_truth_source",
        "error",
        "next_actions",
        "availability"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "show" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required", "actual", "message", "recoverable"],
          "properties": {
            "type": { "const": "truth-source-unavailable" },
            "required": { "$ref": "#/$defs/truth_requirement" },
            "actual": { "$ref": "#/$defs/truth_source" },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "type": "boolean" }
          }
        },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "truth_resolver_internal_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "schema_version",
        "_truth_source",
        "error",
        "next_actions",
        "availability"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "show" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "const": "unavailable" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "message",
            "recoverable",
            "redacted_cause",
            "log_event",
            "correlation_id",
            "bead_reference"
          ],
          "properties": {
            "type": { "const": "truth-resolver-internal-error" },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "const": false },
            "redacted_cause": { "$ref": "#/$defs/non_empty_string" },
            "log_event": { "const": "fcp.truth_resolver.internal_error" },
            "correlation_id": { "$ref": "#/$defs/non_empty_string" },
            "bead_reference": { "const": "flywheel_connectors-hr0rr.2.5" }
          }
        },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    }
  }
}
