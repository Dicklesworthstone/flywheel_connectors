{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/fwc/list/v1",
  "title": "FWC List v1",
  "description": "Stable JSON output schema for `fwc list --json`, including truth-source metadata.",
  "oneOf": [
    { "$ref": "#/$defs/host_success" },
    { "$ref": "#/$defs/offline_success" },
    { "$ref": "#/$defs/missing_host" },
    { "$ref": "#/$defs/ambiguous_catalog_source" },
    { "$ref": "#/$defs/truth_source_unavailable" },
    { "$ref": "#/$defs/truth_resolver_internal_error" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_non_empty_string": {
      "anyOf": [
        { "$ref": "#/$defs/non_empty_string" },
        { "type": "null" }
      ]
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "truth_source": {
      "type": "string",
      "enum": ["mesh", "host", "node-local", "offline", "degraded", "fallback-derived", "simulated", "unavailable"]
    },
    "truth_requirement": {
      "type": "string",
      "enum": ["mesh", "mesh-or-host", "any-live"]
    },
    "schema_version": {
      "const": "fcp.fwc.truth-source.v1"
    },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "command",
        "authoritative",
        "explanation",
        "recoverable",
        "next_actions"
      ],
      "properties": {
        "availability": {
          "type": "string",
          "enum": [
            "live-runtime",
            "offline-artifact",
            "unsupported",
            "planned",
            "unavailable",
            "denied",
            "unknown"
          ]
        },
        "command": { "const": "list" },
        "authoritative": { "type": "boolean" },
        "explanation": { "$ref": "#/$defs/non_empty_string" },
        "recoverable": { "type": "boolean" },
        "next_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "source", "authoritative", "caveat"],
      "properties": {
        "command": { "const": "list" },
        "source": {
          "type": "string",
          "enum": [
            "live_host_inventory",
            "live_host_introspection",
            "workspace_manifest",
            "local_catalog_cache",
            "static_schema"
          ]
        },
        "authoritative": { "type": "boolean" },
        "caveat": { "$ref": "#/$defs/non_empty_string" },
        "fetched_at": { "$ref": "#/$defs/nullable_non_empty_string" }
      }
    },
    "cache_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hit", "validated", "etag", "age_ms", "source"],
      "properties": {
        "hit": { "type": "boolean" },
        "validated": { "type": "boolean" },
        "etag": { "$ref": "#/$defs/non_empty_string" },
        "age_ms": { "$ref": "#/$defs/non_negative_integer" },
        "source": { "const": "workspace-manifests" }
      }
    },
    "metadata_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["known", "unknown", "unsupported", "unavailable", "not-applicable"]
        },
        "value": {}
      }
    },
    "host_filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "category"],
      "properties": {
        "zone": { "$ref": "#/$defs/nullable_non_empty_string" },
        "category": { "$ref": "#/$defs/nullable_non_empty_string" }
      }
    },
    "offline_filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "category", "include_hidden"],
      "properties": {
        "zone": { "$ref": "#/$defs/nullable_non_empty_string" },
        "category": { "$ref": "#/$defs/nullable_non_empty_string" },
        "include_hidden": { "type": "boolean" }
      }
    },
    "missing_host_filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "category", "include_hidden", "require_source"],
      "properties": {
        "zone": { "$ref": "#/$defs/nullable_non_empty_string" },
        "category": { "$ref": "#/$defs/nullable_non_empty_string" },
        "include_hidden": { "type": "boolean" },
        "require_source": {
          "anyOf": [
            { "$ref": "#/$defs/truth_requirement" },
            { "type": "null" }
          ]
        }
      }
    },
    "host_connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "canonical_id",
        "name",
        "description",
        "version",
        "cohort",
        "categories",
        "format",
        "state",
        "home_zone",
        "archetypes",
        "operation_count",
        "max_risk",
        "has_events",
        "next_actions"
      ],
      "properties": {
        "slug": { "$ref": "#/$defs/non_empty_string" },
        "canonical_id": { "$ref": "#/$defs/non_empty_string" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "description": { "type": "string" },
        "version": { "$ref": "#/$defs/non_empty_string" },
        "cohort": { "type": "null" },
        "categories": { "$ref": "#/$defs/string_array" },
        "format": { "type": "null" },
        "state": { "$ref": "#/$defs/non_empty_string" },
        "home_zone": { "type": "null" },
        "archetypes": { "type": "null" },
        "operation_count": { "$ref": "#/$defs/non_negative_integer" },
        "max_risk": { "$ref": "#/$defs/non_empty_string" },
        "has_events": { "$ref": "#/$defs/metadata_field" },
        "next_actions": { "$ref": "#/$defs/next_actions" }
      }
    },
    "offline_connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "canonical_id",
        "name",
        "description",
        "version",
        "cohort",
        "status",
        "hidden_by_default",
        "non_live_rationale",
        "graduation_guidance",
        "format",
        "state",
        "archetypes",
        "home_zone",
        "operation_count",
        "max_risk",
        "has_events",
        "next_actions"
      ],
      "properties": {
        "slug": { "$ref": "#/$defs/non_empty_string" },
        "canonical_id": { "$ref": "#/$defs/non_empty_string" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "description": { "type": "string" },
        "version": { "$ref": "#/$defs/non_empty_string" },
        "cohort": { "$ref": "#/$defs/nullable_non_empty_string" },
        "status": { "$ref": "#/$defs/nullable_non_empty_string" },
        "hidden_by_default": { "type": "boolean" },
        "non_live_rationale": { "$ref": "#/$defs/nullable_non_empty_string" },
        "graduation_guidance": { "$ref": "#/$defs/nullable_non_empty_string" },
        "format": { "$ref": "#/$defs/non_empty_string" },
        "state": { "$ref": "#/$defs/non_empty_string" },
        "archetypes": {
          "anyOf": [
            { "$ref": "#/$defs/string_array" },
            { "type": "null" }
          ]
        },
        "home_zone": {},
        "operation_count": { "$ref": "#/$defs/non_negative_integer" },
        "max_risk": { "$ref": "#/$defs/non_empty_string" },
        "has_events": { "$ref": "#/$defs/metadata_field" },
        "next_actions": { "$ref": "#/$defs/next_actions" }
      }
    },
    "host_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "source",
        "mode",
        "message",
        "filters",
        "filter_gaps",
        "registry_version",
        "cache",
        "connectors",
        "next_actions",
        "provenance",
        "schema_version",
        "_truth_source",
        "availability"
      ],
      "properties": {
        "status": { "const": "ok" },
        "command": { "const": "list" },
        "source": { "const": "host-admin-api" },
        "mode": { "const": "live-inventory" },
        "message": { "$ref": "#/$defs/non_empty_string" },
        "filters": { "$ref": "#/$defs/host_filters" },
        "filter_gaps": { "$ref": "#/$defs/string_array" },
        "registry_version": {},
        "cache": {},
        "connectors": {
          "type": "array",
          "items": { "$ref": "#/$defs/host_connector" }
        },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "offline_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "source",
        "mode",
        "message",
        "filters",
        "hidden_by_default_omitted",
        "connectors",
        "next_actions",
        "provenance",
        "_cache",
        "schema_version",
        "_truth_source",
        "availability"
      ],
      "properties": {
        "status": { "const": "ok" },
        "command": { "const": "list" },
        "source": { "const": "workspace-manifests" },
        "mode": { "const": "offline-artifact" },
        "message": { "$ref": "#/$defs/non_empty_string" },
        "filters": { "$ref": "#/$defs/offline_filters" },
        "hidden_by_default_omitted": { "$ref": "#/$defs/non_negative_integer" },
        "connectors": {
          "type": "array",
          "items": { "$ref": "#/$defs/offline_connector" }
        },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "_cache": { "$ref": "#/$defs/cache_evidence" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "missing_host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "schema_version",
        "_truth_source",
        "error",
        "details",
        "next_actions",
        "availability"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "list" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "const": "offline" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message", "recoverable"],
          "properties": {
            "type": { "const": "missing-host-endpoint" },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "type": "boolean" }
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filters"],
          "properties": {
            "filters": { "$ref": "#/$defs/missing_host_filters" }
          }
        },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "ambiguous_catalog_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "schema_version",
        "_truth_source",
        "error",
        "next_actions",
        "availability"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "list" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "const": "offline" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message", "recoverable"],
          "properties": {
            "type": { "const": "ambiguous-catalog-source" },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "type": "boolean" }
          }
        },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "truth_source_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "schema_version",
        "_truth_source",
        "error",
        "next_actions",
        "availability"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "list" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required", "actual", "message", "recoverable"],
          "properties": {
            "type": { "const": "truth-source-unavailable" },
            "required": { "$ref": "#/$defs/truth_requirement" },
            "actual": { "$ref": "#/$defs/truth_source" },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "type": "boolean" }
          }
        },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "truth_resolver_internal_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "schema_version",
        "_truth_source",
        "error",
        "next_actions",
        "availability"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "list" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "const": "unavailable" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "message",
            "recoverable",
            "redacted_cause",
            "log_event",
            "correlation_id",
            "bead_reference"
          ],
          "properties": {
            "type": { "const": "truth-resolver-internal-error" },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "const": false },
            "redacted_cause": { "$ref": "#/$defs/non_empty_string" },
            "log_event": { "const": "fcp.truth_resolver.internal_error" },
            "correlation_id": { "$ref": "#/$defs/non_empty_string" },
            "bead_reference": { "const": "flywheel_connectors-hr0rr.2.5" }
          }
        },
        "next_actions": { "$ref": "#/$defs/next_actions" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    }
  }
}
