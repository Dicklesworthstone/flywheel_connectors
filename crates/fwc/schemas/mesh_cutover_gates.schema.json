{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/fwc/mesh-cutover-gates/v1",
  "title": "FWC Mesh Cutover Gates v1",
  "description": "Stable JSON output schema for `fwc mesh cutover-gates --json`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "command",
    "subcommand",
    "schema_version",
    "data_hash",
    "live_telemetry",
    "overall_status",
    "gate_count",
    "red_gate_ids",
    "targets",
    "measurement_contract",
    "gates",
    "next_actions",
    "availability"
  ],
  "properties": {
    "status": { "const": "ok" },
    "command": { "const": "mesh" },
    "subcommand": { "const": "cutover-gates" },
    "schema_version": { "const": "1.2.0" },
    "data_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "live_telemetry": { "$ref": "#/$defs/live_telemetry" },
    "overall_status": { "$ref": "#/$defs/cutover_gate_status" },
    "gate_count": {
      "type": "integer",
      "minimum": 0
    },
    "red_gate_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_connectors",
        "replica_count",
        "state_staleness_seconds",
        "audit_staleness_seconds",
        "policy_peer_count"
      ],
      "properties": {
        "min_connectors": { "$ref": "#/$defs/non_negative_integer" },
        "replica_count": { "$ref": "#/$defs/non_negative_integer" },
        "state_staleness_seconds": { "$ref": "#/$defs/non_negative_integer" },
        "audit_staleness_seconds": { "$ref": "#/$defs/non_negative_integer" },
        "policy_peer_count": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "measurement_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_model", "green_requires", "proxy_signals_rejected"],
      "properties": {
        "truth_model": { "const": "fail-closed" },
        "green_requires": { "$ref": "#/$defs/non_empty_string" },
        "proxy_signals_rejected": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cutover_gate" }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "availability": { "$ref": "#/$defs/command_availability" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "cutover_gate_status": {
      "type": "string",
      "enum": ["green", "red", "skip"]
    },
    "json_object": {
      "type": "object"
    },
    "nullable_non_negative_integer": {
      "anyOf": [{ "$ref": "#/$defs/non_negative_integer" }, { "type": "null" }]
    },
    "nullable_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        { "type": "null" }
      ]
    },
    "live_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "state",
        "reason_code",
        "direct_gate_telemetry_available",
        "endpoint_hash",
        "catalog_connector_count",
        "missing_routes",
        "message"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["none", "host-admin-api"]
        },
        "state": {
          "type": "string",
          "enum": ["not-requested", "reachable", "unavailable"]
        },
        "reason_code": { "$ref": "#/$defs/non_empty_string" },
        "direct_gate_telemetry_available": { "type": "boolean" },
        "endpoint_hash": { "$ref": "#/$defs/nullable_sha256" },
        "catalog_connector_count": { "$ref": "#/$defs/nullable_non_negative_integer" },
        "missing_routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "error_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "message": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "cutover_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "name",
        "predicate_text",
        "status",
        "measured_value",
        "target",
        "how_measured",
        "remediation"
      ],
      "properties": {
        "gate_id": { "$ref": "#/$defs/non_empty_string" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "predicate_text": { "$ref": "#/$defs/non_empty_string" },
        "status": { "$ref": "#/$defs/cutover_gate_status" },
        "measured_value": { "$ref": "#/$defs/json_object" },
        "target": { "$ref": "#/$defs/json_object" },
        "how_measured": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "remediation": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "command_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "command",
        "authoritative",
        "explanation",
        "recoverable",
        "next_actions"
      ],
      "properties": {
        "availability": {
          "type": "string",
          "enum": [
            "live-runtime",
            "offline-artifact",
            "unsupported",
            "planned",
            "unavailable",
            "denied",
            "unknown"
          ]
        },
        "command": { "$ref": "#/$defs/non_empty_string" },
        "authoritative": { "type": "boolean" },
        "explanation": { "$ref": "#/$defs/non_empty_string" },
        "recoverable": { "type": "boolean" },
        "next_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    }
  }
}
