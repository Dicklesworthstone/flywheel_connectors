{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/fwc/history/v1",
  "title": "FWC History v1",
  "description": "Stable JSON output schema for `fwc history --json`, including truth-source metadata.",
  "oneOf": [
    { "$ref": "#/$defs/history_list" },
    { "$ref": "#/$defs/history_entry_lookup" },
    { "$ref": "#/$defs/history_not_found" },
    { "$ref": "#/$defs/truth_source_unavailable" },
    { "$ref": "#/$defs/truth_resolver_internal_error" }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "nullable_non_empty_string": {
      "anyOf": [{ "$ref": "#/$defs/non_empty_string" }, { "type": "null" }]
    },
    "truth_source": {
      "type": "string",
      "enum": [
        "mesh",
        "host",
        "node-local",
        "offline",
        "degraded",
        "fallback-derived",
        "simulated",
        "unavailable"
      ]
    },
    "schema_version": {
      "const": "fcp.fwc.truth-source.v1"
    },
    "operation_status": {
      "type": "string",
      "enum": ["success", "error", "timeout", "rate_limited", "denied", "simulated"]
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "timestamp",
        "connector_id",
        "operation_id",
        "input_hash",
        "input_summary",
        "status",
        "latency_ms"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/non_empty_string" },
        "timestamp": { "$ref": "#/$defs/non_empty_string" },
        "connector_id": { "$ref": "#/$defs/non_empty_string" },
        "operation_id": { "$ref": "#/$defs/non_empty_string" },
        "zone": { "$ref": "#/$defs/non_empty_string" },
        "input_hash": { "$ref": "#/$defs/non_empty_string" },
        "input_summary": { "$ref": "#/$defs/non_empty_string" },
        "output_hash": { "$ref": "#/$defs/non_empty_string" },
        "output_summary": { "$ref": "#/$defs/non_empty_string" },
        "status": { "$ref": "#/$defs/operation_status" },
        "latency_ms": { "$ref": "#/$defs/non_negative_integer" },
        "error_code": { "$ref": "#/$defs/non_empty_string" },
        "idempotency_key": { "$ref": "#/$defs/non_empty_string" },
        "agent_session": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "history_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector", "status", "since", "limit"],
      "properties": {
        "connector": { "$ref": "#/$defs/nullable_non_empty_string" },
        "status": {
          "anyOf": [{ "$ref": "#/$defs/operation_status" }, { "type": "null" }]
        },
        "since": { "$ref": "#/$defs/nullable_non_empty_string" },
        "limit": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "command",
        "authoritative",
        "explanation",
        "recoverable",
        "next_actions"
      ],
      "properties": {
        "availability": {
          "type": "string",
          "enum": [
            "live-runtime",
            "offline-artifact",
            "unsupported",
            "planned",
            "unavailable",
            "denied",
            "unknown"
          ]
        },
        "command": { "$ref": "#/$defs/non_empty_string" },
        "authoritative": { "type": "boolean" },
        "explanation": { "$ref": "#/$defs/non_empty_string" },
        "recoverable": { "type": "boolean" },
        "next_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "history_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "scope",
        "schema_version",
        "_truth_source",
        "total_entries",
        "returned",
        "filter",
        "entries",
        "next_actions",
        "availability"
      ],
      "properties": {
        "status": { "const": "ok" },
        "command": { "const": "history" },
        "scope": { "const": "list" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "total_entries": { "$ref": "#/$defs/non_negative_integer" },
        "returned": { "$ref": "#/$defs/non_negative_integer" },
        "filter": { "$ref": "#/$defs/history_filter" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/history_entry" }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "history_entry_lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "scope",
        "schema_version",
        "_truth_source",
        "entry",
        "availability"
      ],
      "properties": {
        "status": { "const": "ok" },
        "command": { "const": "history" },
        "scope": { "const": "entry" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "entry": { "$ref": "#/$defs/history_entry" },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "history_not_found": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command", "schema_version", "_truth_source", "error", "next_actions"],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "history" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message"],
          "properties": {
            "type": { "const": "not-found" },
            "message": { "$ref": "#/$defs/non_empty_string" }
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "truth_source_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "schema_version",
        "_truth_source",
        "error",
        "next_actions",
        "availability"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "history" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "$ref": "#/$defs/truth_source" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required", "actual", "message", "recoverable"],
          "properties": {
            "type": { "const": "truth-source-unavailable" },
            "required": {
              "type": "string",
              "enum": ["mesh", "mesh-or-host", "any-live"]
            },
            "actual": { "$ref": "#/$defs/truth_source" },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "type": "boolean" }
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "availability": { "$ref": "#/$defs/availability" }
      }
    },
    "truth_resolver_internal_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command", "schema_version", "_truth_source", "error", "next_actions"],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "history" },
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "_truth_source": { "const": "unavailable" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "message",
            "recoverable",
            "redacted_cause",
            "log_event",
            "correlation_id",
            "bead_reference"
          ],
          "properties": {
            "type": { "const": "truth-resolver-internal-error" },
            "message": { "$ref": "#/$defs/non_empty_string" },
            "recoverable": { "const": false },
            "redacted_cause": { "$ref": "#/$defs/non_empty_string" },
            "log_event": { "const": "fcp.truth_resolver.internal_error" },
            "correlation_id": { "$ref": "#/$defs/non_empty_string" },
            "bead_reference": { "const": "flywheel_connectors-hr0rr.2.5" }
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    }
  }
}
