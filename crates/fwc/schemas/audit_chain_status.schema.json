{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/fwc/audit-chain-status/truth-source-envelope/v1",
  "title": "FWC audit chain status truth-source envelope v1",
  "description": "Top-level provenance envelope for `fwc audit chain status --json`.",
  "oneOf": [
    { "$ref": "#/definitions/audit_chain_status_success" },
    { "$ref": "#/definitions/truth_source_unavailable" },
    { "$ref": "#/definitions/truth_resolver_internal_error" }
  ],
  "definitions": {
    "truth_source": {
      "type": "string",
      "enum": [
        "mesh",
        "host",
        "node-local",
        "offline",
        "degraded",
        "fallback-derived",
        "simulated",
        "unavailable"
      ]
    },
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "live"],
      "properties": {
        "kind": { "$ref": "#/definitions/non_empty_string" },
        "live": { "type": "boolean" },
        "head_path": { "$ref": "#/definitions/non_empty_string" },
        "events_path": { "$ref": "#/definitions/non_empty_string" }
      }
    },
    "audit_chain_status_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "subcommand",
        "schema_version",
        "_truth_source",
        "telemetry_state",
        "source",
        "quorum_signed_checkpoints",
        "quorum_signers",
        "quorum_signer_ids",
        "max_age_seconds",
        "warnings"
      ],
      "properties": {
        "status": { "enum": ["fresh", "stale", "degraded", "missing"] },
        "command": { "const": "audit" },
        "subcommand": { "const": "chain status" },
        "schema_version": { "const": "fcp.fwc.audit_chain_status.v1" },
        "_truth_source": { "$ref": "#/definitions/truth_source" },
        "telemetry_state": { "enum": ["live-host", "artifact", "missing"] },
        "source": { "$ref": "#/definitions/source" },
        "zone_id": { "$ref": "#/definitions/non_empty_string" },
        "head_seq": { "type": "integer", "minimum": 0 },
        "head_entry": { "$ref": "#/definitions/non_empty_string" },
        "last_quorum_height": { "type": "integer", "minimum": 0 },
        "quorum_signed_checkpoints": { "type": "integer", "minimum": 0 },
        "quorum_signers": { "type": "integer", "minimum": 0 },
        "quorum_signer_ids": { "$ref": "#/definitions/string_array" },
        "producer_signature_count": { "type": "integer", "minimum": 0 },
        "signature_count_consistent": { "type": "boolean" },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "quorum_freshness_secs": { "type": "integer", "minimum": 0 },
        "quorum_rotation_epoch": { "$ref": "#/definitions/non_empty_string" },
        "next_rotation_eta_secs": { "type": "integer", "minimum": 0 },
        "hlc_physical_drift_ms": { "type": "integer", "minimum": 0 },
        "max_age_seconds": { "type": "integer", "minimum": 0 },
        "live_quorum_checkpoint_snapshot": true,
        "warnings": { "$ref": "#/definitions/string_array" }
      }
    },
    "truth_source_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "subcommand",
        "schema_version",
        "_truth_source",
        "error",
        "next_actions"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "audit" },
        "subcommand": { "const": "chain status" },
        "schema_version": { "const": "fcp.fwc.truth-source.v1" },
        "_truth_source": { "$ref": "#/definitions/truth_source" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required", "actual", "message", "recoverable"],
          "properties": {
            "type": { "const": "truth-source-unavailable" },
            "required": { "enum": ["mesh", "mesh-or-host", "any-live"] },
            "actual": { "$ref": "#/definitions/truth_source" },
            "message": { "$ref": "#/definitions/non_empty_string" },
            "recoverable": { "type": "boolean" }
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/non_empty_string" }
        }
      }
    },
    "truth_resolver_internal_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "subcommand",
        "schema_version",
        "_truth_source",
        "error",
        "next_actions"
      ],
      "properties": {
        "status": { "const": "error" },
        "command": { "const": "audit" },
        "subcommand": { "const": "chain status" },
        "schema_version": { "const": "fcp.fwc.truth-source.v1" },
        "_truth_source": { "const": "unavailable" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "message",
            "recoverable",
            "redacted_cause",
            "log_event",
            "correlation_id",
            "bead_reference"
          ],
          "properties": {
            "type": { "const": "truth-resolver-internal-error" },
            "message": { "$ref": "#/definitions/non_empty_string" },
            "recoverable": { "const": false },
            "redacted_cause": { "$ref": "#/definitions/non_empty_string" },
            "log_event": { "const": "fcp.truth_resolver.internal_error" },
            "correlation_id": { "$ref": "#/definitions/non_empty_string" },
            "bead_reference": { "const": "flywheel_connectors-hr0rr.2.5" }
          }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/non_empty_string" }
        }
      }
    }
  }
}
