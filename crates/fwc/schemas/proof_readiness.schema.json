{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fcp://schemas/fwc/proof-readiness/v1",
  "title": "FWC Proof Readiness Report v1",
  "description": "Stable JSON output schema for `fwc proof readiness --json`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "targets",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "fcp.fwc.proof-readiness.v1" },
    "status": { "$ref": "#/$defs/readiness_status" },
    "generated_at": { "$ref": "#/$defs/non_empty_string" },
    "targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/target_report" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "availability": { "$ref": "#/$defs/availability" },
    "_output": { "$ref": "#/$defs/output_metadata" }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "readiness_status": {
      "type": "string",
      "enum": ["ready", "missing-prerequisites", "partially-ready", "error"]
    },
    "target_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "blocked_beads",
        "status",
        "missing",
        "satisfied_artifacts",
        "command",
        "redaction_notes",
        "next_actions"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/non_empty_string" },
        "blocked_beads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^flywheel_connectors-[A-Za-z0-9_.-]+$"
          }
        },
        "status": { "$ref": "#/$defs/readiness_status" },
        "missing": {
          "type": "array",
          "items": { "$ref": "#/$defs/missing_prerequisite" }
        },
        "satisfied_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/satisfied_artifact" }
        },
        "command": { "$ref": "#/$defs/proof_command" },
        "redaction_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "next_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "missing_prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "message"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["artifact", "machine-class", "host-role", "schema", "freshness", "threshold", "environment"]
        },
        "id": { "$ref": "#/$defs/non_empty_string" },
        "message": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "satisfied_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "digest", "redacted"],
      "properties": {
        "path": { "$ref": "#/$defs/non_empty_string" },
        "schema_version": { "$ref": "#/$defs/non_empty_string" },
        "digest": {
          "type": "string",
          "pattern": "^(sha256|blake3):[0-9a-f]{64}$"
        },
        "machine_class": {
          "anyOf": [
            { "$ref": "#/$defs/non_empty_string" },
            { "type": "null" }
          ]
        },
        "host_role": {
          "anyOf": [
            { "$ref": "#/$defs/non_empty_string" },
            { "type": "null" }
          ]
        },
        "redacted": { "type": "boolean" }
      }
    },
    "proof_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv_template", "requires_remote", "proof_class"],
      "properties": {
        "argv_template": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "requires_remote": { "type": "boolean" },
        "proof_class": {
          "type": "string",
          "enum": ["remote-cargo", "live-host", "operator-script"]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_count",
        "ready_count",
        "missing_prerequisites_count",
        "partially_ready_count",
        "error_count"
      ],
      "properties": {
        "target_count": { "type": "integer", "minimum": 0 },
        "ready_count": { "type": "integer", "minimum": 0 },
        "missing_prerequisites_count": { "type": "integer", "minimum": 0 },
        "partially_ready_count": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "command",
        "authoritative",
        "explanation",
        "recoverable",
        "next_actions"
      ],
      "properties": {
        "availability": { "$ref": "#/$defs/non_empty_string" },
        "command": { "$ref": "#/$defs/non_empty_string" },
        "authoritative": { "type": "boolean" },
        "explanation": { "$ref": "#/$defs/non_empty_string" },
        "recoverable": { "type": "boolean" },
        "next_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "output_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_format",
        "selected_format",
        "base_format",
        "transform",
        "newline_terminated",
        "token_stats_requested",
        "token_stats_enabled",
        "token_stats_unavailable_reason",
        "exit",
        "token_stats"
      ],
      "properties": {
        "default_format": { "$ref": "#/$defs/non_empty_string" },
        "selected_format": { "$ref": "#/$defs/non_empty_string" },
        "base_format": { "$ref": "#/$defs/non_empty_string" },
        "transform": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            { "type": "null" }
          ]
        },
        "newline_terminated": { "type": "boolean" },
        "token_stats_requested": { "type": "boolean" },
        "token_stats_enabled": { "type": "boolean" },
        "token_stats_unavailable_reason": {
          "anyOf": [
            { "$ref": "#/$defs/non_empty_string" },
            { "type": "null" }
          ]
        },
        "exit": { "$ref": "#/$defs/exit_metadata" },
        "token_stats": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            { "type": "null" }
          ]
        }
      }
    },
    "exit_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "category", "success"],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0
        },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "category": { "$ref": "#/$defs/non_empty_string" },
        "success": { "type": "boolean" }
      }
    }
  }
}
