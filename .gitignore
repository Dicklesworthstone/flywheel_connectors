/test_nan_min
/test_path
/test_preopen

# Beads recovery directories (auto-generated during issue tracker recovery)
.beads/recovery_*/

# FCP host runtime state (generated by tests and host binary)
**/.fcp-host/

# Codex IDE cache
.codex/
.codex-tmp/

# Agent CLI write-probe artifacts. Codex (and adjacent agent CLIs) drop a
# zero-byte probe file at session start to test working-tree writeability;
# `.ec` is a 2-byte session-status marker some agent helpers leave behind.
# Both recur per session and must never land in git history.
.codex-write-probe
.ec

# Remote compilation helper cache
.rch/*
!.rch/
!.rch/config.toml
!.rch/probes/
!.rch/probes/**
.rch/probes/*/target/

# Beads recovery and snapshot directories
.beads/.br_recovery/
.beads/.codex_recovery_*/
.beads/.codex_snapshot_*/

# Clippy analysis output (all variants)
clippy_*.json
clippy_*.txt

# UBS scan output (all variants)
ubs_*.txt
ubs_*.json

# Compiled project binaries
/connector
/fcp-host

# git-stash-janitor workspace (transient, persists across phases of one run)
.stash_janitor_workspace/

# RCH per-job target directories synced back from remote workers
# (e.g. .rch-target-vmi1149989-job-<id>-<nonce>-0/)
.rch-target-*/

# Agent CLI disk-space write probe (zero-byte, recurs per session;
# sibling of .codex-write-probe above)
.restore-space-probe

# Chaos harness runtime campaign output (events.jsonl per campaign id);
# same class as artifacts/ — generated evidence, never repo content
chaos-results/

# Stray rustc metadata artifacts from one-off `rustc --emit=metadata` checks
*.rmeta

# Python bytecode caches (e.g. scripts/ci/__pycache__/)
__pycache__/
*.pyc

# Agent audit-sweep grep scratch outputs (panic/unwrap inventories)
/panics.txt
/unwrap_*.txt

# One-off agent test driver script (run_test / run_test.rs already ignored)
/run_test.sh

# Clippy analysis output, suffix variants (clippy_*.json already ignored)
*_clippy.json
*_clippy.txt

# Ephemeral root-level test binary from cargo test experiments
/test_default
